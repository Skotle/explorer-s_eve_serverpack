#Pick a random mob.
scoreboard players set @s RandomRange 11
execute unless dimension witherstormmod:bowels run scoreboard players remove @s RandomRange 2
function explorers_eve:random
scoreboard players operation @s Math = @s RandomValue

#Spawning time! Each mob will have a comment to say why it's special; these elite mobs have funny attributes.
#Zombie with Charoite to chase down and brutalize the player.
execute if score @s Math matches 0 run summon witherstormmod:sickened_zombie ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.knockback_resistance,Base:0.5},{Name:generic.movement_speed,Base:0.3}],HandItems:[{id:"blue_skies:charoite_axe",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:15s}]}},{}],ArmorItems:[{id:"blue_skies:charoite_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"blue_skies:charoite_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"blue_skies:charoite_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"blue_skies:charoite_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}}]}
#Phantom.
execute if score @s Math matches 1 run summon witherstormmod:sickened_phantom ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Size:4,Attributes:[{Name:generic.movement_speed,Base:1}],HandItems:[{id:"minecraft:diamond_sword",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:3s},{id:"minecraft:knockback",lvl:2s}]}},{}],ArmorItems:[{id:"twilightforest:yeti_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:yeti_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:arctic_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:yeti_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}}]}
#Sickened cow in Steeleaf to emphasize speed and knockback.
execute if score @s Math matches 2 run summon witherstormmod:sickened_mushroom_cow ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.movement_speed,Base:0.35}],HandItems:[{id:"twilightforest:steeleaf_sword",Count:1b,tag:{Enchantments:[{id:"minecraft:knockback",lvl:1s}]}},{}],ArmorItems:[{id:"twilightforest:steeleaf_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"twilightforest:steeleaf_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:steeleaf_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:steeleaf_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}}]}
#Drowned with Neptune and a trident to be AWFUL.
execute if score @s Math matches 3 run summon minecraft:drowned ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.attack_damage,Base:10}],HandItems:[{id:"minecraft:trident",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:15s}]}},{}],ArmorItems:[{id:"aether:neptune_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:neptune_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:neptune_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:neptune_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}}]}
#Pillager with crazy fast arrows.
execute if score @s Math matches 4 run summon witherstormmod:sickened_pillager ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.movement_speed,Base:0.5}],HandItems:[{id:"minecraft:crossbow",Count:1b,tag:{Enchantments:[{id:"minecraft:multishot",lvl:2s},{id:"minecraft:quick_charge",lvl:2s}],ChargedProjectiles:[{id:"minecraft:arrow",Count:1b},{id:"minecraft:arrow",Count:1b},{id:"minecraft:arrow",Count:1b}],Charged:1b}},{}],ArmorItems:[{id:"twilightforest:ironwood_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:3s}]}},{id:"twilightforest:naga_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:3s}]}},{id:"twilightforest:naga_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:3s}]}},{id:"twilightforest:ironwood_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:3s}]}}]}
#Villager knight with a pick that pierces armor.
execute if score @s Math matches 5 run summon witherstormmod:sickened_villager ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.knockback_resistance,Base:0.5},{Name:generic.movement_speed,Base:0.3}],HandItems:[{id:"twilightforest:knightmetal_pickaxe",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:9s}]}},{}],ArmorItems:[{id:"twilightforest:knightmetal_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"twilightforest:knightmetal_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"twilightforest:phantom_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"twilightforest:phantom_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}}]}
#Baby dragon.
execute if score @s Math matches 6 run summon endertrigon:baby_ender_dragon ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,HandItems:[{id:"minecraft:diamond_sword",Count:1b,tag:{Enchantments:[{id:"minecraft:knockback",lvl:1s}]}},{}],ArmorItems:[{id:"minecraft:diamond_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"minecraft:diamond_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"minecraft:diamond_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}},{id:"minecraft:diamond_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:1s}]}}]}
#Zephyr with Valkyrie gear.
execute if score @s Math matches 7 run summon aether:zephyr ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.knockback_resistance,Base:0.5},{Name:generic.movement_speed,Base:1}],ArmorItems:[{id:"aether:valkyrie_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:valkyrie_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:valkyrie_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"aether:valkyrie_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}}]}
#Venom spider carrying nested spider, so it'll always go for melee. Yay!
execute if score @s Math matches 8 run summon blue_skies:venom_spider ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.movement_speed,Base:0.375}],HandItems:[{id:"minecraft:diamond_axe",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:9s}]}},{}],ArmorItems:[{id:"minecraft:diamond_boots",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"minecraft:diamond_leggings",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"minecraft:diamond_chestplate",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}},{id:"minecraft:diamond_helmet",Count:1b,tag:{Enchantments:[{id:"minecraft:protection",lvl:2s}]}}]}

#Mobs past this point cannot be chosen in the Empowered Command Block fight.
#Stonelet with Diopside and stunning speed.
execute if score @s Math matches 9 run summon blue_skies:stonelet ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.movement_speed,Base:0.3}],HandItems:[{id:"blue_skies:diopside_sword",Count:1b,tag:{Enchantments:[{id:"minecraft:sharpness",lvl:3s},{id:"minecraft:knockback",lvl:2s}]}},{}],ArmorItems:[{id:"blue_skies:diopside_boots",Count:1b},{id:"blue_skies:diopside_leggings",Count:1b},{id:"blue_skies:diopside_chestplate",Count:1b},{id:"blue_skies:diopside_helmet",Count:1b}]}
#Piglin brute in Fiery to incinerate the player.
execute if score @s Math matches 10 run summon minecraft:piglin_brute ~ ~ ~ {Tags:["SummonedMob"],PersistenceRequired:1b,Attributes:[{Name:generic.knockback_resistance,Base:0.5},{Name:generic.movement_speed,Base:0.25}],HandItems:[{id:"lost_aether_content:phoenix_axe",Count:1b,tag:{Enchantments:[{id:"minecraft:fire_aspect",lvl:1s}]}},{}],ArmorItems:[{id:"twilightforest:fiery_boots",Count:1b,tag:{Enchantments:[{id:"twilightforest:fire_react",lvl:1s}]}},{id:"twilightforest:fiery_leggings",Count:1b,tag:{Enchantments:[{id:"twilightforest:fire_react",lvl:1s}]}},{id:"twilightforest:fiery_chestplate",Count:1b,tag:{Enchantments:[{id:"twilightforest:fire_react",lvl:1s}]}},{id:"twilightforest:fiery_helmet",Count:1b,tag:{Enchantments:[{id:"twilightforest:fire_react",lvl:1s}]}}]}

#Effects.
execute as @e[tag=SummonedMob] at @s run function explorers_eve:command_block/mobs/elite_effects
particle dust 1 1 1 1 ~ ~0.4 ~ 0.4 0.8 0.4 0.05 25 force
playsound minecraft:entity.blaze.shoot hostile @a ~ ~ ~ 8 1.5

#Then, decrement the timer.
scoreboard players remove @s CommandEliteCount 1